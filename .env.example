# Application
NODE_ENV=development
PORT=3000
APP_NAME=crypto-reconciliation-engine

# MongoDB
MONGODB_URI=mongodb://localhost:27017/crypto_reconciliation
MONGODB_DB_NAME=crypto_reconciliation

# Reconciliation Defaults
TIMESTAMP_TOLERANCE_SECONDS=300
QUANTITY_TOLERANCE_PCT=0.01

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CSV Paths (for script-based ingestion)
USER_CSV_PATH=./data/user-transactions.csv
EXCHANGE_CSV_PATH=./data/exchange-transactions.csv
